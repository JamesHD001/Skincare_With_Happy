# Copy this file to .env and replace the placeholders with values from Neon.
# Use the pooled Neon connection string for application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB_NAME?sslmode=require

# Use the direct (non-pooler) Neon connection string for schema migrations.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB_NAME?sslmode=require

# Runtime configuration for local development and hosted deploys.
APP_ENV=development
PORT=5000
FLASK_DEBUG=0

# The app converts PostgreSQL URLs to the psycopg driver automatically.

# Generate a long random value for Flask sessions before deployment.
SECRET_KEY=replace-with-a-long-random-secret

# Bootstrap credentials for the single admin account. Never commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional payment-provider credentials. Keep these out of Git.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Private S3-compatible receipt storage. Leave unset to disable receipt uploads.
RECEIPT_STORAGE_BUCKET=
RECEIPT_STORAGE_REGION=
RECEIPT_STORAGE_ENDPOINT_URL=
RECEIPT_STORAGE_ACCESS_KEY_ID=
RECEIPT_STORAGE_SECRET_ACCESS_KEY=

# Optional public S3-compatible storage for product images.
# Use a separate bucket and credentials from the private receipt storage.
PRODUCT_IMAGE_STORAGE_BUCKET=
PRODUCT_IMAGE_STORAGE_REGION=
PRODUCT_IMAGE_STORAGE_ENDPOINT_URL=
PRODUCT_IMAGE_STORAGE_ACCESS_KEY_ID=
PRODUCT_IMAGE_STORAGE_SECRET_ACCESS_KEY=
PRODUCT_IMAGE_STORAGE_PUBLIC_BASE_URL=

# Optional public footer details. Social links must use HTTPS.
SOCIAL_INSTAGRAM_URL=
SOCIAL_TIKTOK_URL=
SOCIAL_FACEBOOK_URL=
CONTACT_EMAIL=
CONTACT_PHONE=
